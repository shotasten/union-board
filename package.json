{
  "name": "union-board",
  "version": "0.1.0",
  "description": "出欠も、イベントも、カレンダー連携も、まるっと管理。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "node --require ./scripts/register-typescript6.cjs ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "7.0.2",
    "typescript6": "npm:@typescript/typescript6@6.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
